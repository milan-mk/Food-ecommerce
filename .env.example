# ---- Server ----
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
# How many reverse proxies sit in front of the API (used to find the real visitor IP for rate limiting).
# 1 = Render/Railway alone. 2 = a Vercel rewrite in front of Render.
TRUST_PROXY=1
MONGODB_URI=mongodb://127.0.0.1:27017/food-ecommerce
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- PayPal ----
# developer.paypal.com > Apps & Credentials > Sandbox > create app > copy Client ID + Secret.
# Keep PAYPAL_ENVIRONMENT=sandbox until testing is finished. Never commit the real values.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# ---- Pricing rules ----
CURRENCY=USD
TAX_RATE=0.05
DELIVERY_FEE=2.99
FREE_DELIVERY_THRESHOLD=30

# ---- Dev seed admin (never use these in production) ----
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@12345
