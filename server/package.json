{
  "name": "food-ecommerce-server",
  "version": "1.0.0",
  "private": true,
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "seed": "node seed/seed.js",
    "smoke": "node scripts/smoke-slice2.js",
    "smoke:orders": "node scripts/smoke-slice3.js",
    "smoke:payments": "node scripts/smoke-slice4.js",
    "smoke:admin": "node scripts/smoke-slice5.js",
    "admin:cancel": "node scripts/admin-cancel.js",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand tests/unit",
    "images:generate": "node scripts/generate-product-images.js",
    "images:apply": "node scripts/apply-images.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.4.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ],
    "globalSetup": "<rootDir>/tests/globalSetup.js",
    "globalTeardown": "<rootDir>/tests/globalTeardown.js",
    "testTimeout": 30000,
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  }
}
